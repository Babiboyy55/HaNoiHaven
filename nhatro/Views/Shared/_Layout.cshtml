@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - HanoiHaven</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>    <script src="https://unpkg.com/htmx.org@1.9.12"></script>    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "background": "#faf9fd",
                      "on-secondary": "#ffffff",
                      "secondary-container": "#a2eded",
                      "on-primary-fixed": "#001b3c",
                      "primary": "#002045",
                      "on-primary-fixed-variant": "#2d476f",
                      "on-surface": "#1a1c1e",
                      "primary-fixed": "#d6e3ff",
                      "surface-container-high": "#e9e7eb",
                      "surface-container": "#efedf1",
                      "secondary-fixed": "#a5eff0",
                      "surface-bright": "#faf9fd",
                      "surface-tint": "#455f88",
                      "on-surface-variant": "#43474e",
                      "error-container": "#ffdad6",
                      "error": "#ba1a1a",
                      "inverse-on-surface": "#f1f0f4",
                      "outline": "#74777f",
                      "on-background": "#1a1c1e",
                      "surface": "#faf9fd",
                      "tertiary-container": "#4f2e00",
                      "surface-variant": "#e3e2e6",
                      "secondary-fixed-dim": "#89d3d4",
                      "inverse-primary": "#adc7f7",
                      "surface-container-low": "#f4f3f7",
                      "on-primary-container": "#86a0cd",
                      "on-primary": "#ffffff",
                      "on-secondary-container": "#1a6d6e",
                      "tertiary-fixed": "#ffddba",
                      "primary-container": "#1a365d",
                      "on-tertiary-container": "#c6955e",
                      "tertiary": "#321b00",
                      "secondary": "#13696a",
                      "on-secondary-fixed": "#002020",
                      "outline-variant": "#c4c6cf",
                      "inverse-surface": "#2f3033",
                      "on-error-container": "#93000a",
                      "on-tertiary-fixed-variant": "#633f0f",
                      "surface-container-highest": "#e3e2e6",
                      "surface-container-lowest": "#ffffff",
                      "on-tertiary": "#ffffff",
                      "on-secondary-fixed-variant": "#004f50",
                      "surface-dim": "#dad9dd",
                      "on-error": "#ffffff",
                      "on-tertiary-fixed": "#2b1700",
                      "primary-fixed-dim": "#adc7f7",
                      "tertiary-fixed-dim": "#f2bc82"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "gutter": "24px",
                      "container-max": "1200px",
                      "sm": "12px",
                      "base": "8px",
                      "md": "24px",
                      "xs": "4px",
                      "lg": "48px",
                      "xl": "80px"
              },
              "fontFamily": {
                      "display-lg": ["Inter"],
                      "label-md": ["Inter"],
                      "headline-lg-mobile": ["Inter"],
                      "title-md": ["Inter"],
                      "body-lg": ["Inter"],
                      "body-md": ["Inter"],
                      "headline-lg": ["Inter"],
                      "label-sm": ["Inter"]
              },
              "fontSize": {
                      "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                      "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }],
                      "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                      "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                      "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                      "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                      "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                      "label-sm": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }]
              }
            }
          }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .icon-filled {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        /* Custom Scrollbar for Filters */
        .filter-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .filter-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .filter-scroll::-webkit-scrollbar-thumb {
            background-color: #c4c6cf;
            border-radius: 4px;
        }
        /* === HERO GRADIENT BACKGROUND === */
        .hero-pattern {
            background: linear-gradient(160deg,
                #eef3ff 0%,
                #f0fafa 35%,
                #faf9fd 65%,
                #fff8f0 100%);
            position: relative;
        }
        /* === GLASS CARD === */
        .glass-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 20px 60px -10px rgba(0, 32, 69, 0.08), 0 0 0 1px rgba(0,0,0,0.04);
        }
        /* === TEXT GRADIENT === */
        .text-gradient {
            background: linear-gradient(135deg, #002045 0%, #13696a 60%, #0d8a8b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        /* === GLOW BLOBS === */
        .glow-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            pointer-events: none;
        }
        /* === HEADER GLASS EFFECT === */
        .header-glass {
            background: rgba(250, 249, 253, 0.88);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid rgba(196, 198, 207, 0.25);
        }
        /* === HERO SEARCH DIVIDER === */
        .search-divider {
            width: 1px;
            background: linear-gradient(to bottom, transparent, #c4c6cf, transparent);
            height: 40px;
            align-self: center;
        }
        /* === ROOM CARD HOVER === */
        .room-card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .room-card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 24px 60px -12px rgba(0, 32, 69, 0.12);
        }
        /* === STATS BADGE === */
        .stat-badge {
            background: linear-gradient(135deg, rgba(0,32,69,0.06) 0%, rgba(19,105,106,0.06) 100%);
            border: 1px solid rgba(0,32,69,0.08);
        }
        /* === ANIMATE FADE UP === */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-up {
            animation: fadeUp 0.6s ease forwards;
        }
        .animate-fade-up-delay-1 { animation-delay: 0.1s; opacity: 0; }
        .animate-fade-up-delay-2 { animation-delay: 0.2s; opacity: 0; }
        .animate-fade-up-delay-3 { animation-delay: 0.35s; opacity: 0; }
        .animate-fade-up-delay-4 { animation-delay: 0.5s; opacity: 0; }
    </style>
</head>
<body class="bg-background text-on-surface font-body-md antialiased selection:bg-secondary-container selection:text-on-secondary-container" hx-boost="true">
    <div class="min-h-screen flex flex-col w-full">
    <header class="header-glass w-full sticky top-0 z-50 transition-all duration-300 shadow-[0_1px_12px_rgba(0,0,0,0.06)]">
        <div class="flex justify-between items-center w-full px-4 md:px-8 py-3 max-w-container-max mx-auto gap-4">
            <!-- Brand -->
            <a class="text-2xl md:text-3xl font-black text-primary tracking-tight whitespace-nowrap" href="@Url.Action("Index", "Home")">HanoiHaven</a>
            
            <!-- Search Bar (ẩn ở trang chủ vì đã có hero search) -->
            @{
                var isHomePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
                                 ViewContext.RouteData.Values["action"]?.ToString() == "Index";
            }
            @if (!isHomePage)
            {
                <form action="@Url.Action("Explore", "Home")" method="get" class="hidden md:flex flex-1 max-w-md mx-4 items-center bg-white/80 rounded-full px-4 py-2 border border-outline-variant/40 focus-within:border-secondary focus-within:ring-2 focus-within:ring-secondary/20 transition-all shadow-sm backdrop-blur-sm">
                    <span class="material-symbols-outlined text-outline mr-2 text-[20px]">search</span>
                    <input name="query" class="bg-transparent border-none focus:ring-0 text-on-surface placeholder:text-outline/70 w-full font-body-md py-0 outline-none" placeholder="Tìm kiếm quận, khu vực..." type="text" value="@Context.Request.Query["query"]"/>
                </form>
            }

            <!-- Desktop Navigation & Trailing Actions -->
            <div class="flex items-center gap-3 md:gap-6">
                <!-- Nav -->
                <nav class="hidden lg:flex items-center gap-6">
                    @{
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    }
                    <a class="@((currentAction == "Explore" && currentController == "Home") ? "text-secondary border-b-2 border-secondary pb-1 font-label-md" : "text-on-surface-variant hover:text-primary font-body-md") whitespace-nowrap transition-all" href="@Url.Action("Explore", "Home")">Khám phá</a>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="@((currentAction == "Favorites" && currentController == "Home") ? "text-secondary border-b-2 border-secondary pb-1 font-label-md" : "text-on-surface-variant hover:text-primary font-body-md") whitespace-nowrap transition-colors duration-200" href="@Url.Action("Favorites", "Home")">Phòng yêu thích</a>
                        @if (User.IsInRole("Owner"))
                        {
                            <a class="text-on-surface-variant hover:text-primary font-body-md whitespace-nowrap transition-colors duration-200" href="/Owner">Quản lý trọ</a>
                        }
                        else
                        {
                            <a class="text-on-surface-variant hover:text-primary font-body-md whitespace-nowrap transition-colors duration-200" href="#">Trở thành Chủ nhà</a>
                        }
                    }
                    else
                    {
                        <a class="text-on-surface-variant hover:text-primary font-body-md whitespace-nowrap transition-colors duration-200" href="#">Dành cho Chủ trọ</a>
                    }
                    <a class="text-on-surface-variant hover:text-primary font-body-md whitespace-nowrap transition-colors duration-200" href="#">Trợ giúp</a>
                </nav>

                <!-- Actions -->
                <div class="flex items-center gap-2 md:gap-4 shrink-0">
                    <button class="hidden xl:flex text-on-surface-variant hover:text-secondary transition-colors p-2 rounded-full hover:bg-surface-variant">
                        <span class="material-symbols-outlined text-[22px]">language</span>
                    </button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <button class="hidden md:block text-on-surface-variant hover:text-secondary transition-colors p-2 rounded-full hover:bg-surface-variant relative">
                            <span class="material-symbols-outlined text-[22px]">notifications</span>
                            <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-error rounded-full"></span>
                        </button>

                        <a href="/Owner/Create" class="hidden md:flex items-center justify-center bg-secondary text-on-secondary px-4 py-2 rounded-lg font-label-md hover:bg-secondary/90 transition-colors shadow-sm whitespace-nowrap">
                            Đăng tin
                        </a>

                        <div class="flex items-center gap-3 pl-2 md:pl-4 border-l border-outline-variant/50 ml-1">
                            
                            <!-- User Dropdown Menu -->
                            <div class="relative group cursor-pointer hidden sm:block">
                                <button class="w-10 h-10 rounded-full overflow-hidden border border-outline-variant hover:border-secondary transition-colors focus:outline-none focus:ring-2 focus:ring-secondary/50 shrink-0">
                                    <img alt="User profile" class="w-full h-full object-cover" src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=002045&color=fff"/>
                                </button>
                                <!-- Dropdown -->
                                <div class="absolute right-0 top-full mt-2 w-56 bg-surface-container-lowest rounded-2xl shadow-xl border border-outline-variant/30 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                    <div class="px-4 py-3 border-b border-outline-variant/20">
                                        <p class="text-xs text-outline font-medium">Đã đăng nhập với</p>
                                        <p class="text-sm font-semibold text-primary truncate">@User.Identity.Name</p>
                                    </div>
                                    <a href="/RentalRequest/MyHistory" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                                        Lịch hẹn của tôi
                                    </a>
                                    <a href="/Home/MyContracts" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">description</span>
                                        Hợp đồng & Hóa đơn
                                    </a>
                                    <a href="/Home/Messages" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">chat</span>
                                        Tin nhắn của tôi
                                    </a>
                                    @if (User.IsInRole("Owner"))
                                    {
                                        <a href="/Owner" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">dashboard</span>
                                            Kênh Chủ Trọ
                                        </a>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a href="/Admin" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                                            Trang Quản Trị
                                        </a>
                                    }
                                    <div class="border-t border-outline-variant/20 mt-1 pt-1">
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-error hover:bg-error/5 transition-colors">
                                                <span class="material-symbols-outlined text-[18px]">logout</span>
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="hidden md:flex text-on-surface-variant hover:text-secondary font-title-md text-[15px] transition-colors whitespace-nowrap font-semibold">
                            Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="flex items-center justify-center bg-secondary text-on-secondary px-5 py-2.5 rounded-lg font-title-md text-[15px] hover:bg-secondary/90 transition-colors shadow-sm whitespace-nowrap font-bold">
                            Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow flex flex-col w-full">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-primary dark:bg-primary-container text-on-primary dark:text-on-primary-container mt-auto">
        <div class="w-full py-lg px-md flex flex-col md:flex-row justify-between items-center max-w-container-max mx-auto gap-6">
            <div class="flex flex-col items-center md:items-start">
                <span class="font-title-md text-title-md font-bold text-on-primary mb-2">HanoiHaven</span>
                <p class="font-label-sm text-label-sm text-on-primary-fixed-variant">© 2024 HanoiHaven. Thuê Phòng Uy Tín Tại Hà Nội.</p>
            </div>
            <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
                <a class="text-on-primary-fixed-variant hover:text-on-primary hover:underline decoration-secondary transition-all font-label-sm text-label-sm" href="#">Điều khoản Dịch vụ</a>
                <a class="text-on-primary-fixed-variant hover:text-on-primary hover:underline decoration-secondary transition-all font-label-sm text-label-sm" href="#">Chính sách Bảo mật</a>
                <a class="text-on-primary-fixed-variant hover:text-on-primary hover:underline decoration-secondary transition-all font-label-sm text-label-sm" href="#">Cài đặt Cookie</a>
                <a class="text-on-primary-fixed-variant hover:text-on-primary hover:underline decoration-secondary transition-all font-label-sm text-label-sm" href="#">Liên hệ</a>
            </nav>
        </div>
    </footer>

    <!-- Global Scripts -->
    <script>
        function toggleFavorite(btn, event, roomId) {
            // Ngăn chặn sự kiện click lan sang thẻ a (nếu có)
            event.preventDefault();
            event.stopPropagation();
            
            const isFavorite = btn.classList.contains('is-favorite');
            const icon = btn.querySelector('.material-symbols-outlined');
            
            // Hiệu ứng bong bóng (Scale giật nội tại)
            icon.classList.add('scale-125');
            setTimeout(() => icon.classList.remove('scale-125'), 200);

            if (isFavorite) {
                // Xử lý Bỏ lưu
                btn.classList.remove('text-error', 'is-favorite');
                btn.classList.add('text-on-surface');
                icon.classList.remove('icon-filled');
                icon.innerText = 'favorite_border';
                
                // Nếu đang ở trang Favorites, ẩn luôn thẻ phòng chứa nút này đi để mô phỏng "phòng bay màu"
                if (window.location.pathname.toLowerCase().includes('favorites')) {
                    const card = btn.closest('article');
                    if (card) {
                        card.closest('.favorite-item').style.transition = "all 0.4s ease";
                        card.closest('.favorite-item').style.opacity = "0";
                        card.closest('.favorite-item').style.transform = "scale(0.9)";
                        setTimeout(() => {
                            card.closest('.favorite-item').style.display = "none";
                            // Tùy chọn: Show thông báo rỗng nếu grid không còn item nào (Mockup logic)
                        }, 400); 
                    }
                }
                // TODO: Gọi API AJAX báo server đã gỡ roomId khỏi danh sách
            } else {
                // Xử lý Lưu
                btn.classList.remove('text-on-surface');
                btn.classList.add('text-error', 'is-favorite');
                icon.classList.add('icon-filled');
                icon.innerText = 'favorite';
                // TODO: Gọi API AJAX báo server lưu roomId
            }
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>
</html>
