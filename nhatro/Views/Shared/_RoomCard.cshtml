@model nhatro.Models.RoomListing

<article class="group bg-surface rounded-xl overflow-hidden border border-outline-variant/30 shadow-[0_4px_15px_-4px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_30px_-8px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col relative">
    <!-- Image Area -->
    <div class="relative aspect-[4/3] w-full overflow-hidden bg-surface-variant">
        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('@Model.ImageUrl');">
        </div>
        
        <!-- Badges Top Left -->
        @if (Model.Rating.HasValue || !string.IsNullOrEmpty(Model.StatusBadge))
        {
            <div class="absolute top-3 left-3 flex gap-2">
                @if (Model.Rating.HasValue)
                {
                    <span class="bg-primary/90 backdrop-blur-sm text-on-primary px-3 py-1 rounded-full font-label-sm shadow-sm flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">star</span> @Model.Rating.Value
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.StatusBadge))
                {
                    <span class="bg-secondary/90 backdrop-blur-sm text-on-secondary px-3 py-1 rounded-full font-label-sm shadow-sm">
                        @Model.StatusBadge
                    </span>
                }
            </div>
        }

        <!-- Heart / Save Top Right -->
        <button onclick="toggleFavorite(this, event, @Model.Id)" class="absolute top-3 right-3 p-2 bg-surface/80 backdrop-blur-sm rounded-full @(Model.IsFavorite ? "text-error is-favorite" : "text-on-surface hover:text-error") transition-all hover:bg-surface hover:scale-110 active:scale-95 shadow-sm focus:outline-none z-10">
            <span class="material-symbols-outlined @(Model.IsFavorite ? "icon-filled" : "") text-[20px] transition-transform duration-300">@(Model.IsFavorite ? "favorite" : "favorite_border")</span>
        </button>
    </div>
    <!-- Content Area -->
    <div class="p-5 flex flex-col flex-grow bg-surface">
        <!-- Location & Title -->
        <div class="mb-2">
            <div class="flex items-center gap-1 text-outline font-label-sm mb-1 uppercase tracking-wider">
                <span class="material-symbols-outlined text-[14px]">location_on</span> @Model.Location
            </div>
            <h3 class="font-title-md text-primary line-clamp-1 group-hover:text-secondary transition-colors">
                <a href="@Url.Action("Detail", "Home", new { id = Model.Id })">@Model.Title</a>
            </h3>
        </div>
        <!-- Amenities (Stroke icons) -->
        <div class="flex items-center gap-4 mb-4 text-on-surface-variant">
            @foreach (var amenity in Model.Amenities)
            {
                <div class="flex items-center gap-1" @(!string.IsNullOrEmpty(amenity.Title) ? $"title=\"{amenity.Title}\"" : "")>
                    <span class="material-symbols-outlined text-[18px]">@amenity.Icon</span>
                    <span class="text-sm">@amenity.Text</span>
                </div>
            }
        </div>
        <!-- Price & Action (Bottom aligned) -->
        <div class="mt-auto pt-4 border-t border-outline-variant/20 flex justify-between items-end">
            <div>
                <span class="text-sm text-on-surface-variant">Từ</span>
                <div class="font-headline-lg-mobile text-primary tracking-tight">
                    @Model.Price.ToString("N0")<span class="text-sm font-normal text-on-surface-variant ml-1">VNĐ/tháng</span>
                </div>
            </div>
            <a href="@Url.Action("Detail", "Home", new { id = Model.Id })" class="px-4 py-2 rounded-lg border border-primary text-primary font-label-md hover:bg-primary hover:text-on-primary transition-colors inline-block text-center text-sm font-semibold">
                Chi tiết
            </a>
        </div>
    </div>
</article>
