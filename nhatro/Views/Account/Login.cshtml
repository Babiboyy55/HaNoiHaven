@model nhatro.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Hanoi Haven</title>
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"></noscript>
    <style>
        body { background-color: #F8F9FB; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; min-height: 100vh; overflow-x: hidden; }
        .split-screen { display: flex; min-height: 100vh; }
        
        /* Cột ảnh bên trái */
        .left-side { flex: 1; background-image: url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80'); background-size: cover; background-position: center; position: relative; color: white; display: flex; flex-direction: column; justify-content: flex-end; padding: 50px; }
        .overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, transparent, rgba(12, 30, 58, 0.9)); z-index: 1; }
        .left-content { position: relative; z-index: 2; }
        .brand-title { font-size: 3.5rem; font-weight: bold; margin-bottom: 10px; }
        
        /* Cột form bên phải */
        .right-side { flex: 1; display: flex; align-items: center; justify-content: center; background-color: #F8F9FB; padding: 40px; }
        .form-container { width: 100%; max-width: 450px; }
        .form-control { border-radius: 6px; padding: 12px 15px; border-color: #E2E8F0; margin-bottom: 15px; }
        .form-control:focus { border-color: #136A64; box-shadow: 0 0 0 0.2rem rgba(19, 106, 100, 0.25); }
        .input-icon { position: absolute; left: 15px; top: 15px; color: #94A3B8; }
        .has-icon { padding-left: 45px; }
        .form-label { font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 5px; display: block; }
        .btn-custom { background-color: #136A64; color: white; font-weight: 500; border-radius: 6px; padding: 14px; margin-top: 10px; transition: all 0.2s; }
        .btn-custom:hover { background-color: #0f544f; color: white; }
        
        /* Nút đăng nhập MXH */
        .social-btn { border: 1px solid #E2E8F0; background: white; color: #334155; font-weight: 500; border-radius: 6px; padding: 10px; display: flex; justify-content: center; align-items: center; gap: 10px; transition: all 0.2s; }
        .social-btn:hover { background: #f8fafc; }
        
        /* Responsive */
        @@media (max-width: 992px) {
            .left-side { display: none; }
        }
    </style>
</head>
<body>
    <div class="split-screen">
        
        <div class="left-side">
            <div class="overlay"></div>
            <div class="left-content">
                <h1 class="brand-title">Hanoi Haven</h1>
                <p class="fs-5 text-light">Chào mừng trở lại! Tiếp tục quản lý tài sản hoặc tìm kiếm không gian sống lý tưởng của bạn.</p>
            </div>
        </div>

        <div class="right-side">
            <div class="form-container">
                <h1 class="fw-bold mb-2" style="color: #0C1E3A;">Đăng nhập</h1>
                <p class="text-muted mb-4">Vui lòng đăng nhập vào tài khoản của bạn.</p>
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold" style="font-size: 0.9rem;"></div>
                
                <form asp-action="Login" method="post">
                    
                    <div class="position-relative">
                        <label class="form-label">Địa chỉ Email</label>
                        <i class="fa-regular fa-envelope input-icon"></i>
                        <input asp-for="Email" class="form-control has-icon" placeholder="Nhập email của bạn" />
                        <span asp-validation-for="Email" class="text-danger d-block" style="font-size:0.85rem; margin-top:-10px; margin-bottom: 10px;"></span>
                    </div>

                    <div class="position-relative">
                        <label class="form-label">Mật khẩu</label>
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input asp-for="Password" class="form-control has-icon" placeholder="Nhập mật khẩu" type="password" />
                        <span asp-validation-for="Password" class="text-danger d-block" style="font-size:0.85rem; margin-top:-10px; margin-bottom: 10px;"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" style="cursor: pointer;">
                            <label class="form-check-label text-muted" for="rememberCheck" style="font-size: 0.85rem; cursor: pointer;">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>
                        <a href="#" style="color: #136A64; font-size: 0.85rem; font-weight: bold; text-decoration: none;">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-custom w-100 mb-4">Đăng nhập <i class="fa-solid fa-arrow-right ms-2"></i></button>
                    
                    <div class="text-center text-muted mb-3" style="font-size: 0.85rem;">Hoặc tiếp tục với</div>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <a href="#" class="btn social-btn w-100 text-decoration-none">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" style="width: 18px; height: 18px;"> Google
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="btn social-btn w-100 text-decoration-none">
                                <i class="fa-brands fa-facebook" style="color: #1877F2; font-size: 18px;"></i> Facebook
                            </a>
                        </div>
                    </div>

                    <div class="text-center mt-2 text-muted">
                        Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" style="color: #136A64; text-decoration: none; font-weight: bold;">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
        
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>