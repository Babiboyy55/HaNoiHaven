@model List<nhatro.Models.RentalRequest>
@{
    ViewData["Title"] = "Quản lý Yêu Cầu Xem Phòng";
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
}

<div class="min-h-screen bg-gray-50 p-6 md:p-10">
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">📅 Yêu cầu Hẹn Xem Phòng</h1>
            <p class="text-gray-500 mt-1">Danh sách các yêu cầu hẹn xem phòng từ khách hàng</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="bg-amber-100 text-amber-800 text-sm font-semibold px-4 py-2 rounded-full">
                @Model.Count(r => r.Status == "Chờ duyệt") đang chờ duyệt
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 px-6 py-4 rounded-xl mb-6 flex items-center gap-3">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="text-6xl mb-4">📭</div>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Chưa có yêu cầu nào</h3>
            <p class="text-gray-500">Các yêu cầu hẹn xem phòng từ khách hàng sẽ hiển thị ở đây</p>
        </div>
    }
    else
    {
        <!-- Status filter tabs -->
        <div class="flex gap-2 mb-6 flex-wrap">
            <button onclick="filterStatus('all')" id="tab-all"
                class="px-4 py-2 rounded-full text-sm font-medium bg-[#136A64] text-white transition-colors">
                Tất cả (@Model.Count)
            </button>
            <button onclick="filterStatus('Chờ duyệt')" id="tab-pending"
                class="px-4 py-2 rounded-full text-sm font-medium bg-amber-100 text-amber-800 hover:bg-amber-200 transition-colors">
                Chờ duyệt (@Model.Count(r => r.Status == "Chờ duyệt"))
            </button>
            <button onclick="filterStatus('Đã duyệt')" id="tab-approved"
                class="px-4 py-2 rounded-full text-sm font-medium bg-green-100 text-green-800 hover:bg-green-200 transition-colors">
                Đã duyệt (@Model.Count(r => r.Status == "Đã duyệt"))
            </button>
            <button onclick="filterStatus('Đã từ chối')" id="tab-rejected"
                class="px-4 py-2 rounded-full text-sm font-medium bg-red-100 text-red-800 hover:bg-red-200 transition-colors">
                Đã từ chối (@Model.Count(r => r.Status == "Đã từ chối"))
            </button>
        </div>

        <div class="space-y-4" id="requests-list">
            @foreach (var request in Model)
            {
                <div class="request-card bg-white rounded-2xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow" data-status="@request.Status">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                        <!-- Left Info -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#136A64] to-teal-400 flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
                                @(request.TenantName.Length > 0 ? request.TenantName[0].ToString().ToUpper() : "K")
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800 text-base">@request.TenantName</p>
                                <p class="text-sm text-gray-500 flex items-center gap-1 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                    <a href="tel:@request.TenantPhone" class="text-[#136A64] hover:underline font-medium">@request.TenantPhone</a>
                                </p>
                                <p class="text-xs text-gray-400 mt-1">Gửi lúc: @request.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div class="flex-shrink-0">
                            @{
                                var (badgeClass, badgeIcon) = request.Status switch
                                {
                                    "Đã duyệt" => ("bg-green-100 text-green-800", "✅"),
                                    "Đã từ chối" => ("bg-red-100 text-red-800", "❌"),
                                    "Đã hủy" => ("bg-gray-100 text-gray-600", "🚫"),
                                    _ => ("bg-amber-100 text-amber-800", "⏳")
                                };
                            }
                            <span class="@badgeClass px-3 py-1.5 rounded-full text-xs font-bold">
                                @badgeIcon @request.Status
                            </span>
                        </div>
                    </div>

                    <!-- Room & Schedule Info -->
                    <div class="mt-4 bg-gray-50 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
                        <div>
                            <p class="text-gray-400 text-xs font-medium mb-1">🏠 Phòng muốn xem</p>
                            @if (request.RoomListing != null)
                            {
                                <a href="/Home/Detail/@request.RoomListingId" class="text-[#136A64] font-semibold hover:underline">@request.RoomListing.Title</a>
                                <p class="text-gray-500 text-xs">@request.RoomListing.Location</p>
                            }
                            else
                            {
                                <p class="text-gray-700 font-medium">Phòng #@request.RoomListingId</p>
                            }
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs font-medium mb-1">📅 Ngày hẹn</p>
                            <p class="text-gray-700 font-semibold">@request.PreferredDate.ToString("dd/MM/yyyy")</p>
                            <p class="text-gray-500 text-xs">@request.PreferredTime</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs font-medium mb-1">💬 Lời nhắn</p>
                            <p class="text-gray-700 italic text-xs">@(string.IsNullOrEmpty(request.Message) ? "Không có lời nhắn" : request.Message)</p>
                        </div>
                    </div>

                    <!-- Actions (only show if Chờ duyệt) -->
                    @if (request.Status == "Chờ duyệt")
                    {
                        <div class="mt-4 flex gap-3">
                            <form method="post" asp-controller="RentalRequest" asp-action="Approve" class="flex-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@request.Id" />
                                <button type="submit" class="w-full bg-[#136A64] hover:bg-[#0f544f] text-white py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                    ✅ Xác nhận lịch hẹn
                                </button>
                            </form>
                            <form method="post" asp-controller="RentalRequest" asp-action="Reject" class="flex-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@request.Id" />
                                <button type="submit" class="w-full bg-white hover:bg-red-50 text-red-600 border border-red-200 py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                    ❌ Từ chối
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<script>
function filterStatus(status) {
    const cards = document.querySelectorAll('.request-card');
    cards.forEach(card => {
        if (status === 'all' || card.dataset.status === status) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}
</script>
