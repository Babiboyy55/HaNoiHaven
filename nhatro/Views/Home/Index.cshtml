@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="relative pt-lg pb-xl md:pt-xl md:pb-[120px] px-4 md:px-xl hero-pattern border-b border-surface-variant overflow-hidden">
    <div class="max-w-container-max mx-auto relative z-10 flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-fixed text-primary text-label-sm font-label-sm mb-6 border border-inverse-primary shadow-sm"><span class="material-symbols-outlined text-[16px] icon-filled">verified</span> Danh sách đã xác thực tại Hà Nội</div>
        <h1 class="font-display-lg text-display-lg md:text-[56px] md:leading-[64px] text-primary mb-6 max-w-3xl">Tìm Kiếm Không Gian <br class="hidden md:block"> Sống Lý Tưởng Tại <span class="text-gradient">Hà Nội</span></h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-12">Khám phá các phòng và căn hộ cao cấp tại Cầu Giấy, Đống Đa và Hai Bà Trưng. Chủ nhà uy tín, giá cả minh bạch và không chi phí ẩn.</p>
        <!-- Search Bar -->
        <div class="w-full max-w-4xl glass-card rounded-xl p-4 md:p-6 shadow-[0_15px_30px_-5px_rgba(0,0,0,0.08)] border border-outline-variant/30 flex flex-col md:flex-row gap-4">
            <div class="flex-1 relative">
                <label class="block text-label-sm font-label-sm text-on-surface-variant mb-1 ml-1">Quận/Huyện</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
                    <select class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg py-3 pl-10 pr-4 text-body-md font-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 appearance-none outline-none transition-all cursor-pointer">
                        <option value="">Chọn Quận/Huyện</option>
                        <option value="cau-giay">Cầu Giấy</option>
                        <option value="dong-da">Đống Đa</option>
                        <option value="hai-ba-trung">Hai Bà Trưng</option>
                        <option value="thanh-xuan">Thanh Xuân</option>
                        <option value="hoan-kiem">Hoàn Kiếm</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
            <div class="flex-1 relative">
                <label class="block text-label-sm font-label-sm text-on-surface-variant mb-1 ml-1">Loại phòng</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">bed</span>
                    <select class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg py-3 pl-10 pr-4 text-body-md font-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 appearance-none outline-none transition-all cursor-pointer">
                        <option value="">Mọi loại phòng</option>
                        <option value="studio">Studio</option>
                        <option value="shared">Phòng ghép</option>
                        <option value="1br">1 Phòng ngủ</option>
                        <option value="2br">2+ Phòng ngủ</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
            <div class="flex-1 relative">
                <label class="block text-label-sm font-label-sm text-on-surface-variant mb-1 ml-1">Khoảng giá</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">payments</span>
                    <select class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg py-3 pl-10 pr-4 text-body-md font-body-md text-on-surface focus:border-secondary focus:ring-2 focus:ring-secondary/20 appearance-none outline-none transition-all cursor-pointer">
                        <option value="">Mọi mức giá</option>
                        <option value="under-3m">Dưới 3 triệu VNĐ</option>
                        <option value="3m-5m">3 triệu - 5 triệu VNĐ</option>
                        <option value="5m-10m">5 triệu - 10 triệu VNĐ</option>
                        <option value="over-10m">Trên 10 triệu VNĐ</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                </div>
            </div>
            <div class="flex items-end mt-2 md:mt-0">
                <button class="w-full md:w-auto bg-secondary text-on-secondary px-8 py-3 rounded-lg font-label-md text-label-md hover:bg-on-secondary-container transition-colors shadow-sm flex items-center justify-center gap-2 h-[48px]"><span class="material-symbols-outlined">search</span> Tìm kiếm</button>
            </div>
        </div>
    </div>
    <!-- Abstract decorative elements -->
    <div class="absolute top-20 -left-20 w-64 h-64 bg-secondary-container rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute bottom-10 -right-20 w-80 h-80 bg-primary-fixed rounded-full mix-blend-multiply filter blur-3xl opacity-40"></div>
</section>

<!-- Featured Rooms Bento Grid -->
<section class="py-xl px-4 md:px-xl max-w-container-max mx-auto bg-surface-container-lowest">
    <div class="flex justify-between items-end mb-10">
        <div>
            <h2 class="font-headline-lg text-headline-lg text-primary mb-2">Phòng Nổi Bật</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Những lựa chọn phòng nghỉ cao cấp được tuyển chọn tại Hà Nội.</p>
        </div>
        <button class="hidden md:flex items-center gap-1 text-secondary font-label-md text-label-md hover:underline decoration-secondary">Xem tất cả phòng <span class="material-symbols-outlined text-[20px]">arrow_forward</span></button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[300px]">
        <!-- Large Featured Item -->
        <div class="md:col-span-2 md:row-span-2 rounded-xl overflow-hidden relative group shadow-[0_4px_15px_rgba(0,0,0,0.04)] border border-outline-variant/50 cursor-pointer">
            <div class="absolute inset-0 bg-surface-variant animate-pulse -z-10"></div>
            <img alt="Premium Apartment in Cau Giay" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUzz5n69kvGVxzk9w1qxSN1n4-6ka0-hMNy7rWrCI3m4tMiw0VAK_Yu3Qqv0YFNsz9PV93F1lrLMRRMtmVpk_We06aiigSLjej-qUQ8l_TZiQwfDMMGJRCYzAlHPNWaWrlDemKygP7nu6svP8Hz2V5RN_HdrfqDkbn80qAJ_N8uH99OtnkQWVf3CucU579Tt9EhotwvQ1ClvajWF4yPtKR6wgdDyC03-DJt6fHrzwrkpcj6BaWbAI6wFAXn2hUzgKSWGWZ37xtQrjE">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute top-4 left-4">
                <span class="bg-secondary text-on-secondary px-3 py-1 rounded-full text-label-sm font-label-sm shadow-md">Đang trống</span>
            </div>
            <button class="absolute top-4 right-4 p-2 bg-surface/80 backdrop-blur-sm rounded-full text-on-surface hover:text-error transition-colors">
                <span class="material-symbols-outlined">favorite</span>
            </button>
            <div class="absolute bottom-0 left-0 p-6 w-full text-white">
                <div class="flex items-center gap-2 mb-2 text-surface-container-high">
                    <span class="material-symbols-outlined text-[16px]">location_on</span>
                    <span class="text-label-sm font-label-sm tracking-wide uppercase">Cầu Giấy District</span>
                </div>
                <h3 class="font-headline-lg text-[28px] leading-tight font-bold mb-2">Căn hộ Studio Cao Cấp với Tầm Nhìn Thành Phố</h3>
                <div class="flex justify-between items-end">
                    <div class="flex gap-4">
                        <div class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">bed</span> <span class="text-label-md">1 Giường</span></div>
                        <div class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">shower</span> <span class="text-label-md">1 Tắm</span></div>
                        <div class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">square_foot</span> <span class="text-label-md">45m²</span></div>
                    </div>
                    <div class="text-right">
                        <p class="text-sm opacity-80">từ</p>
                        <p class="font-bold text-[24px]">7.5M <span class="text-sm font-normal">VNĐ/tháng</span></p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Smaller Item 1 -->
        <div class="rounded-xl overflow-hidden relative group shadow-[0_4px_15px_rgba(0,0,0,0.04)] border border-outline-variant/50 flex flex-col cursor-pointer bg-surface">
            <div class="h-48 relative overflow-hidden">
                <img alt="Cozy Room Dong Da" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4Fp_cLjVyFHMPT1Af3Xi-M4svQbFku3wVaKJszdxPQJFRoYe5kRyPs_pEWJHvgiggHKlfJ-8OjhFNt-IZXAoXXShOhUvIBB1kNmqpgFGQpjq2Kosy1gpLLbAvhjHjxCVsDtslXcwR6k3piZ18ZhpNS7MLeWDDiWoX_WS1uvIYbWcn3I3ESX54gAyo5h3CidFIsEmbdoe0AdkUmQjxQhtK4-619pyY5YRiUD1bxXfsMvKPETVcQ-6CjdmVR5U2LCghTr-tnS51s0S5">
                <button class="absolute top-3 right-3 p-1.5 bg-surface/80 backdrop-blur-sm rounded-full text-on-surface hover:text-error transition-colors z-10">
                    <span class="material-symbols-outlined text-[20px]">favorite</span>
                </button>
            </div>
            <div class="p-4 flex-grow flex flex-col justify-between">
                <div>
                    <div class="inline-block bg-surface-variant text-primary px-2 py-0.5 rounded text-xs font-semibold mb-2">Đống Đa</div>
                    <h3 class="font-title-md text-title-md text-primary mb-1 line-clamp-1">Phòng khép kín tiện nghi gần Metro</h3>
                    <p class="text-body-md font-body-md text-on-surface-variant line-clamp-2 text-sm mb-3">Vị trí ngõ yên tĩnh, đầy đủ nội thất với phòng tắm riêng và ban công nhỏ.</p>
                </div>
                <div class="flex justify-between items-center pt-3 border-t border-surface-variant">
                    <span class="font-bold text-primary">4.2M <span class="text-sm font-normal text-on-surface-variant">VNĐ/tháng</span></span>
                    <span class="material-symbols-outlined text-secondary">arrow_forward</span>
                </div>
            </div>
        </div>
        <!-- Smaller Item 2 -->
        <div class="rounded-xl overflow-hidden relative group shadow-[0_4px_15px_rgba(0,0,0,0.04)] border border-outline-variant/50 flex flex-col cursor-pointer bg-surface">
            <div class="h-48 relative overflow-hidden">
                <img alt="Modern Room Hai Ba Trung" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuACROiEt70A3TR6zyD0cxEj6W9wpxlWwCbcLolsuQfCCRbBhpW8FOXIqtEothwnGfhpFJAVmDZeaGTDpsOEoMml6tpsyOq4asRCd2mMfVGIkzephEKIv6DYD5U7cvfxckStxLbtjwMcAR4FkS7cZOG08rPOy09UYcNYG_QvNWyUMB9UWUKUCLNyJjrtQ9n-gc6mn41DGCGhYa6BnhTSf6873_GAoudwZmX7Qa-lCtO6cIpxmefyeg5cdto_Y_pvmO_EZIX0eZI-i1Te">
                <span class="absolute top-3 left-3 bg-error-container text-on-error-container px-2 py-0.5 rounded text-xs font-bold">5.5M <span class="text-sm font-normal text-on-surface-variant">VNĐ/tháng</span></span>
                <button class="absolute top-3 right-3 p-1.5 bg-surface/80 backdrop-blur-sm rounded-full text-on-surface hover:text-error transition-colors z-10">
                    <span class="material-symbols-outlined text-[20px]">favorite</span>
                </button>
            </div>
            <div class="p-4 flex-grow flex flex-col justify-between">
                <div>
                    <div class="inline-block bg-surface-variant text-primary px-2 py-0.5 rounded text-xs font-semibold mb-2">Hai Bà Trưng</div>
                    <h3 class="font-title-md text-title-md text-primary mb-1 line-clamp-1">Phòng Loft Phong Cách Hiện Đại</h3>
                    <p class="text-body-md font-body-md text-on-surface-variant line-clamp-2 text-sm mb-3">Bố trí thông minh tối ưu không gian. Sử dụng chung bếp hiện đại và sân thượng.</p>
                </div>
                <div class="flex justify-between items-center pt-3 border-t border-surface-variant">
                    <span class="font-bold text-primary">5.5M <span class="text-sm font-normal text-on-surface-variant">VNĐ/tháng</span></span>
                    <span class="material-symbols-outlined text-secondary">arrow_forward</span>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-6 text-center md:hidden">
        <button class="inline-flex items-center gap-2 border border-secondary text-secondary px-6 py-2 rounded-lg font-label-md text-label-md w-full justify-center">Xem tất cả phòng</button>
    </div>
</section>
