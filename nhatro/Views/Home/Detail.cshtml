@model nhatro.Models.RoomListing
@{
    ViewData["Title"] = Model.Title;
}

@* Toast thông báo khi gửi yêu cầu thành công *@
@if (TempData["SuccessRequest"] != null)
{
    <div id="success-toast" class="fixed top-6 right-6 z-[9999] bg-[#136A64] text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 max-w-sm animate-fade-in-down">
        <span class="material-symbols-outlined text-[28px]">check_circle</span>
        <div>
            <p class="font-semibold text-sm">Gửi yêu cầu thành công!</p>
            <p class="text-xs opacity-80 mt-0.5">@TempData["SuccessRequest"]</p>
        </div>
        <button onclick="document.getElementById('success-toast').remove()" class="ml-2 opacity-70 hover:opacity-100">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>
    <script>setTimeout(() => { const t = document.getElementById('success-toast'); if(t) t.remove(); }, 5000);</script>
}

<div class="w-full max-w-container-max mx-auto px-4 md:px-xl py-6 md:py-10 flex-grow flex flex-col gap-6">
    <!-- Breadcrumb & Back button -->
    <div class="flex items-center justify-between">
        <nav class="flex text-sm text-on-surface-variant gap-2 items-center">
            <a href="@Url.Action("Index", "Home")" class="hover:text-primary transition-colors">Trang chủ</a>
            <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
            <a href="@Url.Action("Explore", "Home")" class="hover:text-primary transition-colors">Khám phá</a>
            <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
            <span class="text-primary truncate max-w-[200px] md:max-w-xs font-medium">@Model.Title</span>
        </nav>
        <a href="javascript:history.back()" class="flex items-center gap-1 text-secondary font-label-md text-sm hover:underline">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Quay lại
        </a>
    </div>

    <!-- Main Title -->
    <div>
        <h1 class="font-headline-lg text-primary text-2xl md:text-3xl font-bold tracking-tight mb-2">@Model.Title</h1>
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-sm text-on-surface-variant">
            <div class="flex items-center gap-1 font-medium">
                <span class="material-symbols-outlined text-[16px] text-secondary">star</span> @(Model.Rating ?? 4.9) (Đánh giá cao)
            </div>
            <div class="w-1 h-1 rounded-full bg-outline-variant hidden sm:block"></div>
            <div class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px] text-outline">location_on</span> @Model.Location
            </div>
        </div>
    </div>

    <!-- Image Gallery -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 rounded-2xl overflow-hidden aspect-[16/9] md:aspect-[21/9] shadow-md border border-outline-variant/30 bg-surface-container">
        <!-- Main Large Image -->
        <div class="md:col-span-2 relative overflow-hidden group h-full">
            <img src="@Model.ImageUrl" alt="@Model.Title" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-102" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent pointer-events-none"></div>
        </div>

        <!-- Right Side Supporting Images -->
        <div class="hidden md:flex flex-col gap-4 h-full">
            @if (Model.RoomImages != null && Model.RoomImages.Count > 1)
            {
                var supportingImages = Model.RoomImages.Skip(1).Take(2).ToList();
                for (int i = 0; i < 2; i++)
                {
                    if (i < supportingImages.Count)
                    {
                        <div class="flex-1 relative overflow-hidden group">
                            <img src="@supportingImages[i].ImageUrl" alt="Ảnh chi tiết @(i + 1)" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        </div>
                    }
                    else
                    {
                        <!-- Default abstract backup pattern if room only has 1 or 2 images -->
                        <div class="flex-1 bg-surface-container-high flex flex-col items-center justify-center text-outline/50 border border-dashed border-outline-variant/50">
                            <span class="material-symbols-outlined text-[32px] mb-1">image</span>
                            <span class="text-xs">HanoiHaven</span>
                        </div>
                    }
                }
            }
            else
            {
                <!-- Abstract fallback images -->
                <div class="flex-1 relative overflow-hidden group">
                    <img src="https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&q=80&w=300" alt="Detail backup" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <div class="flex-1 relative overflow-hidden group">
                    <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=300" alt="Detail backup" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
            }
        </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter mt-4">
        <!-- Left Side: General Info & Description -->
        <div class="lg:col-span-2 flex flex-col gap-8">
            <!-- Fast Metrics Card -->
            <div class="grid grid-cols-3 bg-surface-container-lowest border border-outline-variant/40 rounded-xl p-4 md:p-6 divide-x divide-outline-variant/30 text-center shadow-sm">
                <div>
                    <p class="text-xs text-on-surface-variant mb-1 font-medium">Giá phòng từ</p>
                    <p class="text-lg md:text-xl font-black text-secondary">@Model.Price.ToString("N0") <span class="text-xs font-normal">đ/tháng</span></p>
                </div>
                <div>
                    <p class="text-xs text-on-surface-variant mb-1 font-medium">Diện tích thực tế</p>
                    <p class="text-lg md:text-xl font-bold text-primary">@Model.Area m²</p>
                </div>
                <div>
                    <p class="text-xs text-on-surface-variant mb-1 font-medium">Trạng thái phòng</p>
                    <p class="text-lg md:text-xl font-bold text-secondary-container text-secondary flex items-center justify-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span> @(string.IsNullOrEmpty(Model.StatusBadge) ? "Đang trống" : Model.StatusBadge)
                    </p>
                </div>
            </div>

            <!-- Description -->
            <div>
                <h3 class="font-title-md text-primary font-bold mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">notes</span> Mô tả chi tiết không gian
                </h3>
                <div class="text-on-surface-variant leading-relaxed text-body-md space-y-4">
                    <p>Chào mừng bạn đến với căn hộ cao cấp tại khu vực trung tâm Hà Nội. Phòng trọ được thiết kế vô cùng tinh tế, tận dụng tối đa ánh sáng tự nhiên tạo nên một không gian thoáng đãng, sang trọng nhưng không kém phần ấm cúng.</p>
                    <p>Phòng đã được trang bị đầy đủ nội thất cơ bản, thiết kế theo phong cách tối giản hiện đại. Khách thuê chỉ cần xách vali đến ở ngay. Vị trí nhà trọ nằm trong khu dân trí cao, an ninh nghiêm ngặt 24/7, gần chợ, các trung tâm thương mại và các tuyến xe công cộng vô cùng tiện lợi cho việc di chuyển hàng ngày của sinh viên và người đi làm.</p>
                </div>
            </div>

            <!-- Amenities -->
            <div>
                <h3 class="font-title-md text-primary font-bold mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">verified_user</span> Các tiện ích đi kèm sẵn có
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    @foreach (var amenity in Model.Amenities)
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg border border-outline-variant/20 bg-surface-container-low hover:border-secondary/40 hover:bg-surface-container transition-all group">
                            <span class="material-symbols-outlined text-[24px] text-outline group-hover:text-secondary transition-colors">@amenity.Icon</span>
                            <div>
                                <p class="text-sm font-semibold text-primary">@amenity.Text</p>
                                <p class="text-[11px] text-on-surface-variant">@(amenity.Title ?? "Tiện ích sẵn")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Safety & Regulations -->
            <div class="border-t border-outline-variant/30 pt-6">
                <h3 class="font-title-md text-primary font-bold mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">gavel</span> Quy định chung & An toàn
                </h3>
                <ul class="space-y-2 text-sm text-on-surface-variant">
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-secondary">check_circle</span> Giờ giấc tự do, chìa khóa trao tay (cửa vân tay thông minh)</li>
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-secondary">check_circle</span> Bảo đảm phòng ngừa cháy nổ (có thiết bị báo cháy, bình cứu hỏa mỗi tầng)</li>
                    <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-secondary">check_circle</span> Giữ gìn vệ sinh chung, khu giặt sấy dùng chung sạch sẽ gọn gàng</li>
                </ul>
            </div>
        </div>

        <!-- Right Side: Contact Sidebar (Sticky) -->
        <div class="relative">
            <div class="lg:sticky lg:top-24 flex flex-col gap-6">
                <!-- Owner Contact Card -->
                <div class="bg-surface-container border border-outline-variant/30 rounded-2xl p-6 shadow-sm flex flex-col gap-4">
                    <h3 class="font-semibold text-primary text-lg">Thông tin Chủ trọ</h3>
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full overflow-hidden border border-outline-variant shadow-inner">
                            <img src="https://ui-avatars.com/api/?name=@(ViewBag.OwnerName)&background=13696a&color=fff&size=120" alt="Chủ nhà" class="w-full h-full object-cover" />
                        </div>
                        <div>
                            <p class="font-bold text-primary leading-tight text-base">@ViewBag.OwnerName</p>
                            <p class="text-xs text-on-surface-variant flex items-center gap-1 mt-0.5">
                                <span class="material-symbols-outlined text-[14px] text-secondary icon-filled">verified</span> Đối tác HanoiHaven uy tín
                            </p>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2 mt-2">
                        <a href="tel:@ViewBag.OwnerPhone" class="w-full bg-[#136A64] hover:bg-[#0f544f] text-white py-3 rounded-lg font-label-md text-center transition-colors flex items-center justify-center gap-2 shadow-sm font-semibold">
                            <span class="material-symbols-outlined text-[20px]">phone</span> Gọi điện thoại: @ViewBag.OwnerPhone
                        </a>
                        <a href="https://zalo.me/@ViewBag.OwnerPhone" target="_blank" class="w-full border border-secondary text-secondary hover:bg-secondary-container/20 py-3 rounded-lg font-label-md text-center transition-colors flex items-center justify-center gap-2 font-semibold">
                            <span class="material-symbols-outlined text-[20px]">chat</span> Chat Zalo ngay
                        </a>
                    </div>
                </div>

                @* Schedule Visit Form - Kết nối với Backend thực *@
                <div class="bg-surface-container-lowest border border-outline-variant/40 rounded-2xl p-6 shadow-sm flex flex-col gap-4">
                    <h4 class="font-semibold text-primary text-base flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary">calendar_month</span> Hẹn lịch xem phòng
                    </h4>
                    <p class="text-xs text-on-surface-variant leading-relaxed">Chọn ngày và giờ phù hợp nhất để đến xem phòng trực tiếp. Chủ nhà sẽ xác nhận lịch hẹn của bạn.</p>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-controller="RentalRequest" asp-action="Create" class="flex flex-col gap-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roomListingId" value="@Model.Id" />
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">Ngày muốn xem</label>
                                <input type="date" name="preferredDate" required
                                    class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5 text-sm focus:border-secondary focus:ring-1 focus:ring-secondary transition-all outline-none"
                                    min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">Khung giờ</label>
                                <select name="preferredTime" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5 text-sm focus:border-secondary focus:ring-1 focus:ring-secondary transition-all outline-none">
                                    <option value="Sáng (08:00 - 11:30)">Sáng (08:00 - 11:30)</option>
                                    <option value="Chiều (13:30 - 17:30)">Chiều (13:30 - 17:30)</option>
                                    <option value="Tối (18:00 - 20:30)">Tối (18:00 - 20:30)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">Tin nhắn (tùy chọn)</label>
                                <textarea name="message" placeholder="Tôi muốn hẹn đến xem căn hộ này vào..."
                                    class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5 text-sm focus:border-secondary focus:ring-1 focus:ring-secondary transition-all outline-none h-16 resize-none"></textarea>
                            </div>

                            <button type="submit" id="btn-send-request" class="w-full bg-primary hover:bg-primary/90 text-white py-3 rounded-lg font-label-md text-sm font-semibold transition-colors mt-2 flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[18px]">send</span>
                                Gửi yêu cầu hẹn xem
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="bg-surface-container-low rounded-xl p-4 text-center flex flex-col gap-3 border border-outline-variant/30">
                            <span class="material-symbols-outlined text-[36px] text-outline/60 mx-auto">lock</span>
                            <p class="text-sm text-on-surface-variant">Bạn cần đăng nhập để đặt lịch hẹn xem phòng</p>
                            <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Detail", "Home", new { id = Model.Id }) })"
                               class="w-full bg-primary hover:bg-primary/90 text-white py-2.5 rounded-lg text-sm font-semibold transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[16px]">login</span> Đăng nhập để đặt lịch
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
