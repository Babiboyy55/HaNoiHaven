@model IEnumerable<nhatro.Models.RoomListing>
@{
    ViewData["Title"] = "Kết quả tìm kiếm phòng";
}

<div class="flex-grow flex flex-col md:flex-row w-full max-w-container-max mx-auto px-4 md:px-xl py-md md:py-lg gap-gutter">
    <!-- Mobile View Toggle (Map vs List) - Visible only on small screens -->
    <div class="md:hidden flex justify-between items-center mb-4 bg-surface-container-low p-1 rounded-lg w-full">
        <button id="btn-grid-mobile" onclick="toggleView('grid')" class="flex-1 bg-surface shadow-sm rounded-md py-2 font-label-md text-primary flex items-center justify-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[18px]">list</span> Danh sách
        </button>
        <button id="btn-map-mobile" onclick="toggleView('map')" class="flex-1 text-on-surface-variant bg-transparent rounded-md py-2 font-label-md hover:bg-surface-variant flex items-center justify-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[18px]">map</span> Bản đồ
        </button>
    </div>
    <!-- Left Sidebar: Advanced Filters -->
    <aside class="hidden md:block w-72 shrink-0 self-start sticky top-24 max-h-[calc(100vh-120px)] overflow-y-auto filter-scroll pr-4 pb-8">
        <form method="get" action="@Url.Action("Explore", "Home")">
            @if (!string.IsNullOrEmpty(ViewBag.Query as string))
            {
                <input type="hidden" name="query" value="@ViewBag.Query" />
            }
            <div class="flex items-center justify-between mb-6">
                <h2 class="font-title-md text-title-md text-primary">Bộ lọc</h2>
                <a href="@Url.Action("Explore", "Home")" class="text-secondary font-label-sm hover:underline">Đặt lại</a>
            </div>
            <!-- Price Range -->
            <div class="mb-8 border-b border-outline-variant/30 pb-6">
                <h3 class="font-label-md text-label-md mb-4 text-on-surface">Khoảng giá (VNĐ/tháng)</h3>
                <div class="flex items-center gap-2 mb-4">
                    <div class="flex-1 relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">₫</span>
                        <input name="minPrice" class="w-full pl-8 pr-3 py-2 bg-surface border border-outline-variant rounded-lg text-sm focus:border-secondary focus:ring-1 focus:ring-secondary transition-all" type="number" value="@(ViewBag.MinPrice ?? 3000000)" />
                    </div>
                    <span class="text-outline">-</span>
                    <div class="flex-1 relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">₫</span>
                        <input name="maxPrice" class="w-full pl-8 pr-3 py-2 bg-surface border border-outline-variant rounded-lg text-sm focus:border-secondary focus:ring-1 focus:ring-secondary transition-all" type="number" value="@(ViewBag.MaxPrice ?? 15000000)" />
                    </div>
                </div>
            </div>
            <!-- Room Type (Pills) -->
            @{
                var roomTypes = ViewBag.RoomTypes as string[] ?? Array.Empty<string>();
            }
            <div class="mb-8 border-b border-outline-variant/30 pb-6">
                <h3 class="font-label-md text-label-md mb-4 text-on-surface">Loại phòng</h3>
                <div class="flex flex-wrap gap-2">
                    <label class="cursor-pointer">
                        <input name="roomTypes" value="Studio" @(roomTypes.Contains("Studio") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                        <div class="px-4 py-2 rounded-full border border-outline-variant text-sm font-medium peer-checked:bg-secondary-container peer-checked:border-secondary-container peer-checked:text-on-secondary-container transition-all hover:bg-surface-container">
                            Studio
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input name="roomTypes" value="Phòng chung" @(roomTypes.Contains("Phòng chung") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                        <div class="px-4 py-2 rounded-full border border-outline-variant text-sm font-medium peer-checked:bg-secondary-container peer-checked:border-secondary-container peer-checked:text-on-secondary-container transition-all hover:bg-surface-container">
                            Phòng chung
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input name="roomTypes" value="Nguyên căn" @(roomTypes.Contains("Nguyên căn") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                        <div class="px-4 py-2 rounded-full border border-outline-variant text-sm font-medium peer-checked:bg-secondary-container peer-checked:border-secondary-container peer-checked:text-on-secondary-container transition-all hover:bg-surface-container">
                            Nguyên căn
                        </div>
                    </label>
                </div>
            </div>
            <!-- Amenities -->
            @{
                var amenities = ViewBag.Amenities as string[] ?? Array.Empty<string>();
            }
            <div class="mb-8 border-b border-outline-variant/30 pb-6">
                <h3 class="font-label-md text-label-md mb-4 text-on-surface">Tiện nghi</h3>
                <div class="space-y-3">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="relative flex items-center justify-center">
                            <input name="amenities" value="Điều hòa" @(amenities.Contains("Điều hòa") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                            <div class="w-5 h-5 border-2 border-outline rounded bg-surface peer-checked:bg-secondary peer-checked:border-secondary transition-colors"></div>
                            <span class="material-symbols-outlined absolute text-white text-[16px] opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none" data-icon="check">check</span>
                        </div>
                        <span class="text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-outline">ac_unit</span> Điều hòa
                        </span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="relative flex items-center justify-center">
                            <input name="amenities" value="WiFi tốc độ cao" @(amenities.Contains("WiFi tốc độ cao") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                            <div class="w-5 h-5 border-2 border-outline rounded bg-surface peer-checked:bg-secondary peer-checked:border-secondary transition-colors"></div>
                            <span class="material-symbols-outlined absolute text-white text-[16px] opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none" data-icon="check">check</span>
                        </div>
                        <span class="text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-outline">wifi</span> WiFi tốc độ cao
                        </span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="relative flex items-center justify-center">
                            <input name="amenities" value="Chỗ để xe" @(amenities.Contains("Chỗ để xe") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                            <div class="w-5 h-5 border-2 border-outline rounded bg-surface peer-checked:bg-secondary peer-checked:border-secondary transition-colors"></div>
                            <span class="material-symbols-outlined absolute text-white text-[16px] opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none" data-icon="check">check</span>
                        </div>
                        <span class="text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-outline">local_parking</span> Chỗ để xe
                        </span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="relative flex items-center justify-center">
                            <input name="amenities" value="Bếp riêng" @(amenities.Contains("Bếp riêng") ? "checked" : "") class="peer sr-only" type="checkbox" onchange="this.form.submit()" />
                            <div class="w-5 h-5 border-2 border-outline rounded bg-surface peer-checked:bg-secondary peer-checked:border-secondary transition-colors"></div>
                            <span class="material-symbols-outlined absolute text-white text-[16px] opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none" data-icon="check">check</span>
                        </div>
                        <span class="text-body-md text-on-surface-variant group-hover:text-on-surface transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-outline">kitchen</span> Bếp riêng
                        </span>
                    </label>
                </div>
            </div>
            <!-- Distance to Center -->
            <div class="mb-4">
                <h3 class="font-label-md text-label-md mb-4 text-on-surface">Khoảng cách đến trung tâm</h3>
                <select name="distance" onchange="this.form.submit()" class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2 text-body-md focus:border-secondary focus:ring-1 focus:ring-secondary transition-all appearance-none cursor-pointer">
                    <option value="< 2 km" selected="@(ViewBag.Distance == "< 2 km" ? "selected" : null)">&lt; 2 km</option>
                    <option value="< 5 km" selected="@(ViewBag.Distance == "< 5 km" ? "selected" : null)">&lt; 5 km</option>
                    <option value="< 10 km" selected="@(ViewBag.Distance == "< 10 km" ? "selected" : null)">&lt; 10 km</option>
                    <option value="Bất kỳ" selected="@(ViewBag.Distance == "Bất kỳ" || ViewBag.Distance == null ? "selected" : null)">Bất kỳ</option>
                </select>
            </div>
            <button type="submit" class="w-full mt-6 bg-primary text-on-primary py-3 rounded-lg font-label-md hover:bg-primary/90 transition-colors shadow-sm">
                Áp dụng
            </button>
        </form>
    </aside>
    <!-- Main Listings Canvas (Bento/Asymmetric feel rather than standard list) -->
    <section class="flex-1 min-w-0 flex flex-col">
        <!-- Header & Map Toggle Desktop -->
        <div class="flex justify-between items-end mb-6">
            <div>
                <h1 class="font-headline-lg-mobile md:font-headline-lg text-primary tracking-tight mb-1">Chỗ ở tại Tây Hồ</h1>
                <p class="text-on-surface-variant font-body-md">24 chỗ ở cao cấp hiện có</p>
            </div>
            <div class="hidden md:flex items-center gap-4">
                <div class="flex items-center bg-surface-container rounded-lg p-1 border border-outline-variant/20">
                    <button id="btn-grid" onclick="toggleView('grid')" class="px-4 py-1.5 rounded-md bg-surface shadow-sm font-label-md text-primary flex items-center gap-2 transition-all">
                        <span class="material-symbols-outlined text-[18px]">grid_view</span> Lưới
                    </button>
                    <button id="btn-map" onclick="toggleView('map')" class="px-4 py-1.5 rounded-md text-on-surface-variant bg-transparent font-label-md hover:text-primary flex items-center gap-2 transition-all">
                        <span class="material-symbols-outlined text-[18px]">map</span> Bản đồ
                    </button>
                </div>
            </div>
        </div>
        <!-- Listings Grid (Responsive: 1 col mobile, 2 col tablet, complex grid large desktop) -->
        <div id="view-grid">
            <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-2 gap-6 pb-12">
                @foreach (var room in Model)
                {
                    <partial name="_RoomCard" model="room" />
                }
            </div>
            
            <!-- Pagination -->
            <div class="flex justify-center mt-auto pb-8">
                <nav class="flex items-center gap-2">
                    <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-variant transition-colors disabled:opacity-50">
                        <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                    </button>
                    <button class="w-10 h-10 flex items-center justify-center rounded-lg bg-secondary text-on-secondary font-label-md">1</button>
                    <button class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-variant text-on-surface font-label-md transition-colors">2</button>
                    <button class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-surface-variant text-on-surface font-label-md transition-colors">3</button>
                    <span class="text-on-surface-variant px-2">...</span>
                    <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-variant transition-colors">
                        <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                    </button>
                </nav>
            </div>
        </div>

        <!-- Map View (Hidden by default) -->
        <div id="view-map" class="hidden flex-grow w-full h-[600px] min-h-[500px] bg-surface-container rounded-xl overflow-hidden shadow-sm border border-outline-variant/20 mb-8 relative">
            <!-- Tạm thời dùng iframe Google Maps nhúng trực tiếp làm mockup -->
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1m3!1d3723.635832049363!2d105.8115682!3d21.047271!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135aafe71772643%3A0xc3972a9de1fd4356!2sT%C3%A2y%20H%E1%BB%93%2C%20Hanoi%2C%20Vietnam!5e0!3m2!1sen!2s!4v1716942000000!5m2!1sen!2s" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            
            <!-- Floating indicator over map -->
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-4 py-2 rounded-lg shadow font-label-md text-primary font-medium flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-secondary animate-pulse"></div>
                Hiển thị @Model.Count() phòng tại Tây Hồ
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function toggleView(view) {
            const btnGrid = document.getElementById('btn-grid');
            const btnMap = document.getElementById('btn-map');
            const viewGrid = document.getElementById('view-grid');
            const viewMap = document.getElementById('view-map');
            const btnGridMobile = document.getElementById('btn-grid-mobile');
            const btnMapMobile = document.getElementById('btn-map-mobile');

            if (view === 'grid') {
                viewGrid.classList.remove('hidden');
                viewMap.classList.add('hidden');
                
                if (btnGrid && btnMap) {
                    btnGrid.classList.add('bg-surface', 'shadow-sm', 'text-primary');
                    btnGrid.classList.remove('text-on-surface-variant', 'bg-transparent');
                    btnMap.classList.remove('bg-surface', 'shadow-sm', 'text-primary');
                    btnMap.classList.add('text-on-surface-variant', 'bg-transparent');
                }

                if (btnGridMobile && btnMapMobile) {
                    btnGridMobile.classList.add('bg-surface', 'shadow-sm', 'text-primary');
                    btnGridMobile.classList.remove('text-on-surface-variant', 'bg-transparent');
                    btnMapMobile.classList.remove('bg-surface', 'shadow-sm', 'text-primary');
                    btnMapMobile.classList.add('text-on-surface-variant', 'bg-transparent');
                }
            } else {
                viewGrid.classList.add('hidden');
                viewMap.classList.remove('hidden');
                
                if (btnGrid && btnMap) {
                    btnMap.classList.add('bg-surface', 'shadow-sm', 'text-primary');
                    btnMap.classList.remove('text-on-surface-variant', 'bg-transparent');
                    btnGrid.classList.remove('bg-surface', 'shadow-sm', 'text-primary');
                    btnGrid.classList.add('text-on-surface-variant', 'bg-transparent');
                }

                if (btnGridMobile && btnMapMobile) {
                    btnMapMobile.classList.add('bg-surface', 'shadow-sm', 'text-primary');
                    btnMapMobile.classList.remove('text-on-surface-variant', 'bg-transparent');
                    btnGridMobile.classList.remove('bg-surface', 'shadow-sm', 'text-primary');
                    btnGridMobile.classList.add('text-on-surface-variant', 'bg-transparent');
                }
            }
        }
    </script>
}
