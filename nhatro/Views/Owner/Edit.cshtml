@model nhatro.Models.RoomListing
@{
    ViewData["Title"] = "Cập nhật tin đăng";
}

<div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-8">
        <a asp-action="ManageListings" class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-600 transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Cập nhật tin đăng</h1>
            <p class="text-gray-500 text-sm mt-1">Chỉnh sửa thông tin bài đăng cho thuê phòng của bạn.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] border border-gray-100">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4 text-sm font-medium"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Tiêu đề tin đăng <span class="text-red-500">*</span></label>
                <input asp-for="Title" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Ví dụ: Studio cao cấp ban công thoáng mát..." />
                <span asp-validation-for="Title" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Địa chỉ khu vực <span class="text-red-500">*</span></label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">location_on</span>
                    <input asp-for="Location" class="w-full pl-12 pr-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Ví dụ: Quận Cầu Giấy, Hà Nội" />
                </div>
                <span asp-validation-for="Location" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Giá cho thuê (VND/Tháng) <span class="text-red-500">*</span></label>
                    <input asp-for="Price" type="number" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Ví dụ: 5000000" />
                    <span asp-validation-for="Price" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Diện tích (m²) <span class="text-red-500">*</span></label>
                    <input asp-for="Area" type="number" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Ví dụ: 25" />
                    <span asp-validation-for="Area" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Mô tả chi tiết <span class="text-red-500">*</span></label>
                <textarea asp-for="Description" rows="4" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all resize-none"></textarea>
            </div>

            @{
                var currentAmenities = Model.Amenities?.Select(a => a.Text).ToList() ?? new List<string>();
            }

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-3">Tiện nghi có sẵn</label>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-100">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="selectedAmenities" value="Điều hòa" @(currentAmenities.Contains("Điều hòa") ? "checked" : "") class="w-5 h-5 accent-[#136A64] cursor-pointer" />
                        <span class="text-sm font-medium text-gray-700 group-hover:text-[#136A64] transition-colors">Điều hòa</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="selectedAmenities" value="WiFi tốc độ cao" @(currentAmenities.Contains("WiFi tốc độ cao") ? "checked" : "") class="w-5 h-5 accent-[#136A64] cursor-pointer" />
                        <span class="text-sm font-medium text-gray-700 group-hover:text-[#136A64] transition-colors">WiFi tốc độ cao</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="selectedAmenities" value="Chỗ để xe" @(currentAmenities.Contains("Chỗ để xe") ? "checked" : "") class="w-5 h-5 accent-[#136A64] cursor-pointer" />
                        <span class="text-sm font-medium text-gray-700 group-hover:text-[#136A64] transition-colors">Chỗ để xe</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="selectedAmenities" value="Bếp riêng" @(currentAmenities.Contains("Bếp riêng") ? "checked" : "") class="w-5 h-5 accent-[#136A64] cursor-pointer" />
                        <span class="text-sm font-medium text-gray-700 group-hover:text-[#136A64] transition-colors">Bếp riêng</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="selectedAmenities" value="Giường nệm" @(currentAmenities.Contains("Giường nệm") ? "checked" : "") class="w-5 h-5 accent-[#136A64] cursor-pointer" />
                        <span class="text-sm font-medium text-gray-700 group-hover:text-[#136A64] transition-colors">Giường nệm</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="selectedAmenities" value="Máy giặt" @(currentAmenities.Contains("Máy giặt") ? "checked" : "") class="w-5 h-5 accent-[#136A64] cursor-pointer" />
                        <span class="text-sm font-medium text-gray-700 group-hover:text-[#136A64] transition-colors">Máy giặt chung/riêng</span>
                    </label>
                </div>
            </div>

            <div class="mb-8">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Quy định chung & An toàn</label>
                <textarea asp-for="Rules" rows="3" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all resize-none"></textarea>
            </div>

            <div class="mb-8">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Tải thêm ảnh mới (Tùy chọn)</label>
                <div class="relative bg-gray-50 rounded-xl border-2 border-dashed border-gray-300 p-6 flex flex-col items-center justify-center hover:bg-gray-100 hover:border-[#136A64] transition-all">
                    <span class="material-symbols-outlined text-[40px] text-gray-400 mb-2">cloud_upload</span>
                    <p class="text-sm text-gray-600 font-medium mb-4">Kéo thả hoặc click để tải thêm ảnh</p>
                    
                    <input type="file" name="uploadedFiles" multiple accept="image/*" 
                           class="w-full h-full absolute top-0 left-0 opacity-0 cursor-pointer" />
                           
                    <span class="px-4 py-2 bg-[#136A64]/10 text-[#136A64] text-sm font-bold rounded-lg">Chọn các File ảnh</span>
                </div>
                <p class="text-xs text-gray-400 mt-2">Giữ phím Ctrl (hoặc Cmd) để chọn nhiều ảnh cùng lúc. Nếu không chọn, hệ thống sẽ giữ nguyên các ảnh cũ.</p>
            </div>

            <div class="flex justify-end gap-4 border-t border-gray-50 pt-6">
                <a asp-action="ManageListings" class="px-6 py-3 rounded-lg font-medium text-gray-600 hover:bg-gray-100 transition-colors">
                    Hủy bỏ
                </a>
                <button type="submit" class="bg-[#136A64] hover:bg-[#0f544f] text-white px-8 py-3 rounded-lg font-medium shadow-md shadow-[#136A64]/20 transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">save</span>
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}