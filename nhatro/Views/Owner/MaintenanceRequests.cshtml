@model IEnumerable<nhatro.Models.MaintenanceRequest>
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Quản lý Yêu cầu sửa chữa";
}

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-2xl font-black text-gray-800 tracking-tight">Yêu cầu sửa chữa & Báo hỏng</h1>
        <p class="text-sm text-gray-500 mt-1">Tiếp nhận thông tin hỏng hóc từ khách thuê và cập nhật tiến độ khắc phục</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-teal-50 border border-teal-200 text-teal-855 px-4 py-3 rounded-xl flex items-center gap-3">
            <span class="material-symbols-outlined text-teal-600">check_circle</span>
            <span class="font-semibold text-sm">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <span class="material-symbols-outlined text-gray-300 text-5xl">build_circle</span>
                <p class="text-gray-500 mt-3 font-semibold font-body-md">Chưa nhận được yêu cầu báo hỏng nào từ khách thuê.</p>
                <p class="text-xs text-gray-400 mt-1">Khi khách thuê gửi phản hồi về sự cố phòng trọ, yêu cầu sẽ hiển thị tại đây.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-sm">
                    <thead>
                        <tr class="bg-gray-50/50 border-b border-gray-100 text-gray-500 font-bold">
                            <th class="p-6">Phòng trọ</th>
                            <th class="p-6">Ngày gửi</th>
                            <th class="p-6">Mô tả sự cố</th>
                            <th class="p-6 text-center">Trạng thái</th>
                            <th class="p-6 text-center">Thao tác xử lý</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-6 font-bold text-gray-800">
                                    @(item.Room?.RoomName ?? "Phòng đã xóa")
                                </td>
                                <td class="p-6 text-gray-500">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="p-6 text-gray-700 font-medium max-w-sm">
                                    @item.Description
                                </td>
                                <td class="p-6 text-center">
                                    @if (item.Status == "Đã hoàn thành")
                                    {
                                        <span class="bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-100">
                                            Đã hoàn thành
                                        </span>
                                    }
                                    else if (item.Status == "Đang xử lý")
                                    {
                                        <span class="bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-100">
                                            Đang xử lý
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-amber-50 text-amber-700 text-xs font-bold px-3 py-1.5 rounded-full border border-amber-100 animate-pulse">
                                            Chờ xử lý
                                        </span>
                                    }
                                </td>
                                <td class="p-6 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        @if (item.Status == "Chờ xử lý")
                                        {
                                            <form action="/Owner/UpdateMaintenanceStatus/@item.Id" method="post" class="inline">
                                                <input type="hidden" name="status" value="Đang xử lý" />
                                                <button type="submit" class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 rounded-lg text-xs font-bold transition-all">
                                                    Nhận sửa chữa
                                                </button>
                                            </form>
                                        }
                                        @if (item.Status == "Chờ xử lý" || item.Status == "Đang xử lý")
                                        {
                                            <form action="/Owner/UpdateMaintenanceStatus/@item.Id" method="post" class="inline">
                                                <input type="hidden" name="status" value="Đã hoàn thành" />
                                                <button type="submit" class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold transition-all">
                                                    Hoàn thành
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 font-medium flex items-center gap-1"><span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span> Đã xử lý xong</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
