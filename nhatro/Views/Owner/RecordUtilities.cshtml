@model nhatro.Models.Invoice
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Ghi nhận điện nước & Phí dịch vụ";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a href="/Owner/Invoices" class="p-2 hover:bg-gray-100 rounded-xl transition-colors text-gray-500">
            <span class="material-symbols-outlined text-[24px]">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-black text-gray-800 tracking-tight">Ghi nhận chỉ số: @ViewBag.RoomName</h1>
            <p class="text-sm text-gray-500 mt-1">Lập hóa đơn tiền phòng kèm chỉ số điện nước sử dụng của tháng</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] p-8">
        <form asp-action="RecordUtilities" method="post" id="utilityForm" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
            <input type="hidden" asp-for="RoomId" />

            <div class="grid grid-cols-2 gap-4 bg-gray-50/50 p-4 rounded-xl border border-gray-100">
                <div>
                    <label class="text-xs text-gray-500 uppercase font-bold">Tháng thanh toán</label>
                    <select asp-for="BillingMonth" class="w-full mt-1 px-3 py-2 rounded-lg border border-gray-200 outline-none text-sm focus:border-[#136A64]">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="text-xs text-gray-500 uppercase font-bold">Năm thanh toán</label>
                    <input asp-for="BillingYear" type="number" class="w-full mt-1 px-3 py-2 rounded-lg border border-gray-200 outline-none text-sm focus:border-[#136A64]" />
                </div>
            </div>

            <!-- Bảng Điện nước -->
            <div class="space-y-6">
                <!-- Chỉ số Điện -->
                <div>
                    <h3 class="font-bold text-gray-800 text-sm border-b border-gray-100 pb-2 mb-4 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-amber-500 text-[18px]">bolt</span>
                        Tiêu thụ Điện
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Chỉ số Cũ (kWh)</label>
                            <input asp-for="ElectricityOld" type="number" step="any" id="elecOld" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="ElectricityOld" class="text-red-500 text-xs"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Chỉ số Mới (kWh)</label>
                            <input asp-for="ElectricityNew" type="number" step="any" id="elecNew" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="ElectricityNew" class="text-red-500 text-xs"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Đơn giá (đ/kWh)</label>
                            <input asp-for="ElectricityPrice" type="number" id="elecPrice" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="ElectricityPrice" class="text-red-500 text-xs"></span>
                        </div>
                    </div>
                </div>

                <!-- Chỉ số Nước -->
                <div>
                    <h3 class="font-bold text-gray-800 text-sm border-b border-gray-100 pb-2 mb-4 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-blue-500 text-[18px]">water_drop</span>
                        Tiêu thụ Nước
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Chỉ số Cũ (m³)</label>
                            <input asp-for="WaterOld" type="number" step="any" id="waterOld" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="WaterOld" class="text-red-500 text-xs"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Chỉ số Mới (m³)</label>
                            <input asp-for="WaterNew" type="number" step="any" id="waterNew" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="WaterNew" class="text-red-500 text-xs"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Đơn giá (đ/m³)</label>
                            <input asp-for="WaterPrice" type="number" id="waterPrice" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="WaterPrice" class="text-red-500 text-xs"></span>
                        </div>
                    </div>
                </div>

                <!-- Tiền phòng & Phí dịch vụ khác -->
                <div>
                    <h3 class="font-bold text-gray-800 text-sm border-b border-gray-100 pb-2 mb-4 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-gray-500 text-[18px]">payments</span>
                        Giá phòng & Phí cố định khác
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Tiền thuê phòng (VND / Tháng)</label>
                            <input asp-for="RoomPrice" type="number" id="roomPrice" readonly class="w-full px-3.5 py-2.5 bg-gray-50 text-gray-500 rounded-xl border border-gray-200 outline-none text-sm transition-all cursor-not-allowed font-semibold" />
                            <span asp-validation-for="RoomPrice" class="text-red-500 text-xs"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-gray-600 font-semibold">Phí dịch vụ khác (Mạng, vệ sinh...)</label>
                            <input asp-for="ServiceFees" type="number" id="serviceFees" placeholder="Ví dụ: 150000" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 focus:border-[#136A64] outline-none text-sm transition-all" />
                            <span asp-validation-for="ServiceFees" class="text-red-500 text-xs"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tổng kết hiển thị thời gian thực -->
            <div class="bg-gray-50 rounded-2xl border border-gray-100 p-6 flex justify-between items-center flex-wrap gap-4">
                <div>
                    <div class="text-xs text-gray-500 font-bold uppercase">Tổng hóa đơn dự tính</div>
                    <div class="text-xs text-gray-400 mt-0.5">Bao gồm tiền phòng + điện nước tiêu thụ + phí dịch vụ</div>
                </div>
                <div class="text-2xl font-black text-[#136A64]" id="liveTotal">
                    0 đ
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <a href="/Owner/Invoices" class="px-6 py-3 border border-gray-200 hover:bg-gray-50 rounded-xl font-bold transition-all text-gray-600">Quay lại</a>
                <button type="submit" class="px-6 py-3 bg-[#136A64] hover:bg-[#0f544f] text-white rounded-xl font-bold transition-all shadow-sm">
                    Lập hóa đơn
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const roomPriceInput = document.getElementById("roomPrice");
        const elecOldInput = document.getElementById("elecOld");
        const elecNewInput = document.getElementById("elecNew");
        const elecPriceInput = document.getElementById("elecPrice");
        const waterOldInput = document.getElementById("waterOld");
        const waterNewInput = document.getElementById("waterNew");
        const waterPriceInput = document.getElementById("waterPrice");
        const serviceFeesInput = document.getElementById("serviceFees");
        const liveTotalDiv = document.getElementById("liveTotal");

        function calculateLiveTotal() {
            const roomPrice = parseFloat(roomPriceInput.value) || 0;
            const elecOld = parseFloat(elecOldInput.value) || 0;
            const elecNew = parseFloat(elecNewInput.value) || 0;
            const elecPrice = parseFloat(elecPriceInput.value) || 0;
            const waterOld = parseFloat(waterOldInput.value) || 0;
            const waterNew = parseFloat(waterNewInput.value) || 0;
            const waterPrice = parseFloat(waterPriceInput.value) || 0;
            const serviceFees = parseFloat(serviceFeesInput.value) || 0;

            let elecDiff = elecNew - elecOld;
            if (elecDiff < 0) elecDiff = 0;
            
            let waterDiff = waterNew - waterOld;
            if (waterDiff < 0) waterDiff = 0;

            const total = roomPrice + (elecDiff * elecPrice) + (waterDiff * waterPrice) + serviceFees;

            liveTotalDiv.innerText = new Intl.NumberFormat('vi-VN').format(total) + " đ";
        }

        // Đăng ký sự kiện
        [elecOldInput, elecNewInput, elecPriceInput, waterOldInput, waterNewInput, waterPriceInput, serviceFeesInput].forEach(input => {
            input.addEventListener("input", calculateLiveTotal);
        });

        // Chạy lần đầu
        calculateLiveTotal();
    </script>
}
