@{
    ViewData["Title"] = "Tổng quan";
}

<div class="max-w-6xl mx-auto">
    
    <div class="flex justify-end mb-8">
        <a href="#" class="bg-[#136A64] hover:bg-[#0f544f] text-white px-6 py-2.5 rounded-lg font-medium shadow-sm transition-colors flex items-center gap-2">
            Thêm tin đăng mới
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] border border-gray-100 flex flex-col justify-between h-40">
            <div class="flex justify-between items-start">
                <div class="w-10 h-10 rounded-lg bg-[#002045] text-white flex items-center justify-center">
                    <span class="material-symbols-outlined">real_estate_agent</span>
                </div>
                <span class="bg-[#a2eded]/40 text-[#136A64] text-xs font-bold px-2.5 py-1 rounded-full">+2 tuần này</span>
            </div>
            <div class="text-4xl font-black text-[#002045]">12</div>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] border border-gray-100 flex flex-col justify-between h-40">
            <div class="flex justify-between items-start">
                <div class="w-10 h-10 rounded-lg bg-[#8B5A2B] text-white flex items-center justify-center">
                    <span class="material-symbols-outlined">hourglass_empty</span>
                </div>
                <div class="w-8 h-8 rounded-full bg-[#FFE4C4]/40 absolute top-6 right-6 -z-10 blur-md"></div>
            </div>
            <div class="text-4xl font-black text-[#002045]">5</div>
        </div>

        <div class="bg-[#002045] rounded-2xl p-6 shadow-md flex flex-col justify-between h-40 relative overflow-hidden">
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-white/5 rounded-full"></div>
            <div class="flex justify-between items-start relative z-10">
                <div class="w-10 h-10 rounded-lg bg-white/10 text-white flex items-center justify-center backdrop-blur-sm">
                    <span class="material-symbols-outlined">account_balance_wallet</span>
                </div>
            </div>
            <div class="relative z-10 flex items-baseline gap-1">
                <div class="text-4xl font-black text-white">24.5M</div>
                <div class="text-white/70 font-medium text-sm">VND</div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] overflow-hidden">
        <div class="flex justify-end p-4 border-b border-gray-50">
            <a href="#" class="text-sm font-semibold text-gray-500 hover:text-gray-800">Xem tất cả</a>
        </div>
        
        <div class="divide-y divide-gray-50">
            <div class="p-4 flex items-center hover:bg-gray-50 transition-colors">
                <div class="flex-1 flex items-center gap-4">
                    <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=100&h=100" class="w-14 h-14 rounded-lg object-cover">
                    <div>
                        <h4 class="font-bold text-gray-800 text-sm">Modern Studio in Tay Ho</h4>
                        <p class="text-xs text-gray-500 mt-0.5">Tay Ho District</p>
                    </div>
                </div>
                <div class="w-32">
                    <span class="inline-flex items-center gap-1.5 bg-[#a2eded]/40 text-[#136A64] text-xs font-bold px-2.5 py-1 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#136A64]"></span> Đã đăng
                    </span>
                </div>
                <div class="w-32 font-medium text-gray-700 text-sm">8,500,000</div>
                <div class="w-20 flex justify-end gap-2 text-gray-400">
                    <button class="hover:text-gray-800"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                    <button class="hover:text-gray-800"><span class="material-symbols-outlined text-[20px]">visibility_off</span></button>
                </div>
            </div>

            <div class="p-4 flex items-center hover:bg-gray-50 transition-colors">
                <div class="flex-1 flex items-center gap-4">
                    <img src="https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&q=80&w=100&h=100" class="w-14 h-14 rounded-lg object-cover">
                    <div>
                        <h4 class="font-bold text-gray-800 text-sm">Cozy Room near Hoan Kiem</h4>
                        <p class="text-xs text-gray-500 mt-0.5">Hoan Kiem District</p>
                    </div>
                </div>
                <div class="w-32">
                    <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-600 text-xs font-bold px-2.5 py-1 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span> Đã cho thuê
                    </span>
                </div>
                <div class="w-32 font-medium text-gray-700 text-sm">6,000,000</div>
                <div class="w-20 flex justify-end gap-2 text-gray-400">
                    <button class="hover:text-gray-800"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                </div>
            </div>

            <div class="p-4 flex items-center hover:bg-gray-50 transition-colors">
                <div class="flex-1 flex items-center gap-4">
                    <div class="w-14 h-14 rounded-lg bg-gray-100 flex items-center justify-center text-gray-300">
                        <span class="material-symbols-outlined">image</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-800 text-sm">Spacious Balcony Apt</h4>
                        <p class="text-xs text-gray-500 mt-0.5">Ba Dinh District</p>
                    </div>
                </div>
                <div class="w-32">
                    <span class="inline-flex items-center gap-1.5 bg-orange-50 text-orange-600 text-xs font-bold px-2.5 py-1 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-orange-600"></span> Bản nháp
                    </span>
                </div>
                <div class="w-32 font-medium text-gray-400 italic text-sm">Chưa thiết lập</div>
                <div class="w-20 flex justify-end gap-2 text-gray-400">
                    <button class="hover:text-gray-800"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                    <button class="hover:text-gray-800"><span class="material-symbols-outlined text-[20px]">upload</span></button>
                </div>
            </div>
        </div>
    </div>
</div>