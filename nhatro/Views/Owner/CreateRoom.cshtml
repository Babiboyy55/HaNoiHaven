@model nhatro.Models.Room
@{
    ViewData["Title"] = "Thêm phòng mới";
}

<div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-8">
        <a asp-action="ManageRooms" class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-600 transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Thêm phòng/tài sản mới</h1>
            <p class="text-gray-500 text-sm mt-1">Quản lý không gian thực tế và thông tin người đang thuê.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] border border-gray-100">
        <form asp-action="CreateRoom" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4 text-sm font-medium"></div>

            <h3 class="text-lg font-bold text-[#002045] mb-4 pb-2 border-b border-gray-100">1. Thông tin tài sản</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tên/Số phòng <span class="text-red-500">*</span></label>
                    <input asp-for="RoomName" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Ví dụ: Phòng 101, Tầng 2..." />
                    <span asp-validation-for="RoomName" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Loại hình</label>
                    <select asp-for="PropertyType" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all appearance-none bg-white">
                        <option value="Phòng trọ">Phòng trọ</option>
                        <option value="Căn hộ mini">Căn hộ mini (Sleepbox)</option>
                        <option value="Nhà nguyên căn">Nhà nguyên căn</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Giá thu thực tế/Tháng <span class="text-red-500">*</span></label>
                    <input asp-for="RentPrice" type="number" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Ví dụ: 3000000" />
                    <span asp-validation-for="RentPrice" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Trạng thái hiện tại</label>
                    <select asp-for="Status" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all appearance-none bg-white">
                        <option value="Trống">Trống (Có thể cho thuê)</option>
                        <option value="Đang thuê">Đang thuê</option>
                        <option value="Bảo trì">Đang sửa chữa/Bảo trì</option>
                    </select>
                </div>
            </div>

            <h3 class="text-lg font-bold text-[#002045] mb-4 pb-2 border-b border-gray-100 mt-8">2. Thông tin khách thuê (Nếu có)</h3>
            <p class="text-sm text-gray-500 mb-4">Để trống nếu phòng hiện tại chưa có ai thuê.</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Tên người thuê</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">person</span>
                        <input asp-for="TenantName" class="w-full pl-12 pr-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="Tên khách đại diện..." />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Số điện thoại</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">call</span>
                        <input asp-for="TenantPhone" class="w-full pl-12 pr-4 py-3 rounded-lg border border-gray-200 focus:border-[#136A64] focus:ring-2 focus:ring-[#136A64]/20 outline-none transition-all" placeholder="SĐT liên hệ..." />
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-4 border-t border-gray-50 pt-6">
                <a asp-action="ManageRooms" class="px-6 py-3 rounded-lg font-medium text-gray-600 hover:bg-gray-100 transition-colors">Hủy bỏ</a>
                <button type="submit" class="bg-[#136A64] hover:bg-[#0f544f] text-white px-8 py-3 rounded-lg font-medium shadow-md transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">save</span> Lưu phòng mới
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}