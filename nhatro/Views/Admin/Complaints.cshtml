@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xử lý Khiếu nại & Tranh chấp";
}

<div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] overflow-hidden">
    <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">gavel</span> Trung tâm giải quyết khiếu nại & tranh chấp
            </h3>
            <p class="text-xs text-gray-500 mt-1">Tiếp nhận phản hồi tiêu cực, xử lý tranh chấp tiền cọc hoặc tố cáo phòng trọ vi phạm</p>
        </div>
        <span class="bg-red-50 border border-red-200 text-red-600 text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Đang xử lý: 2 vụ việc
        </span>
    </div>

    <!-- Disputes List -->
    <div class="divide-y divide-gray-100">
        <!-- Case 1 -->
        <div class="p-6 flex flex-col md:flex-row items-start justify-between gap-6 hover:bg-gray-50/50 transition-colors">
            <div class="flex-1 flex flex-col gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded border border-red-200">Tranh chấp tiền cọc</span>
                    <span class="text-xs text-gray-400">Vụ việc #HN-0284</span>
                    <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                    <span class="text-xs text-gray-500 font-medium">Gửi lúc: 28/05/2026</span>
                </div>
                <h4 class="font-bold text-[#002045] text-base">Yêu cầu hoàn trả tiền cọc giữ chỗ phòng trọ</h4>
                <p class="text-sm text-gray-600 leading-relaxed">
                    Khách thuê <strong class="text-gray-800">Nguyễn Văn A</strong> khiếu nại Chủ trọ <strong class="text-gray-800">Trần Văn B</strong> về việc không hoàn trả lại 2.000.000 VNĐ tiền cọc giữ chỗ sau khi phát hiện phòng thực tế bị dột nát, không đúng như mô tả bài đăng "Studio Tối Giản Ven Hồ".
                </p>
                <div class="flex items-center gap-4 mt-2 text-xs font-semibold text-gray-500">
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">person</span> Khách thuê: Nguyễn Văn A</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">real_estate_agent</span> Chủ nhà: Trần Văn B</span>
                </div>
            </div>
            
            <div class="flex flex-row md:flex-col gap-2 w-full md:w-auto shrink-0 justify-end mt-4 md:mt-0">
                <button onclick="alert('Đã gửi thông báo cảnh cáo và yêu cầu Chủ trọ phản hồi trong 24h!');" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-xs font-bold shadow-sm transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">warning</span> Yêu cầu giải trình
                </button>
                <button onclick="alert('Đã xử lý: Buộc chủ trọ hoàn trả 100% tiền cọc và ẩn tin bài viết!');" class="bg-[#136A64] hover:bg-[#0f544f] text-white px-4 py-2 rounded-lg text-xs font-bold shadow-sm transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">gavel</span> Phán quyết hoàn trả
                </button>
            </div>
        </div>

        <!-- Case 2 -->
        <div class="p-6 flex flex-col md:flex-row items-start justify-between gap-6 hover:bg-gray-50/50 transition-colors">
            <div class="flex-1 flex flex-col gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="bg-orange-100 text-orange-700 text-[10px] font-bold px-2 py-0.5 rounded border border-orange-200">Mô tả sai lệch tin bài</span>
                    <span class="text-xs text-gray-400">Vụ việc #HN-0281</span>
                    <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                    <span class="text-xs text-gray-500 font-medium">Gửi lúc: 27/05/2026</span>
                </div>
                <h4 class="font-bold text-[#002045] text-base">Phòng dột và thiết bị hư hỏng không sửa chữa</h4>
                <p class="text-sm text-gray-600 leading-relaxed">
                    Khách thuê tố cáo căn hộ "Căn Hộ Dịch Vụ Cao Cấp" tại Quảng An không hề có "Hồ bơi" và "Điều hòa" hoạt động như bài đăng quảng cáo. Sau 3 tuần gửi yêu cầu sửa chữa nhưng chủ nhà không khắc phục và trốn tránh trách nhiệm.
                </p>
                <div class="flex items-center gap-4 mt-2 text-xs font-semibold text-gray-500">
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">person</span> Tố cáo bởi: Lê Thị C</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">real_estate_agent</span> Bị cáo: Nguyễn Văn D</span>
                </div>
            </div>
            
            <div class="flex flex-row md:flex-col gap-2 w-full md:w-auto shrink-0 justify-end mt-4 md:mt-0">
                <button onclick="alert('Đã gửi thông báo kiểm tra thực tế căn hộ!');" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-xs font-bold shadow-sm transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">search</span> Xác minh thực tế
                </button>
                <button onclick="alert('Đã hạ bài viết của chủ trọ khỏi hệ thống!');" class="bg-red-50 text-red-700 border border-red-200 hover:bg-red-600 hover:text-white px-4 py-2 rounded-lg text-xs font-bold shadow-sm transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">block</span> Khóa bài viết
                </button>
            </div>
        </div>
    </div>
</div>
