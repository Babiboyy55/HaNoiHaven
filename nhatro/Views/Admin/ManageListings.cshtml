@model IEnumerable<nhatro.Models.RoomListing>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý & Duyệt bài đăng";
}

<div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] overflow-hidden">
    <!-- Header panel with statistics -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 flex-wrap gap-4">
        <div>
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">fact_check</span> Kiểm duyệt bài đăng phòng trọ
            </h3>
            <p class="text-xs text-gray-500 mt-1">Duyệt hoặc ẩn tin đăng cho thuê phòng trọ trên toàn hệ thống HanoiHaven</p>
        </div>
        <div class="flex gap-2">
            <span class="bg-orange-50 border border-orange-200 text-orange-700 text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span> Chờ duyệt: @Model.Count(r => r.StatusBadge != "Đã đăng" && r.StatusBadge != "Đã ẩn") bài
            </span>
            <span class="bg-secondary/15 text-secondary text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Đã duyệt: @Model.Count(r => r.StatusBadge == "Đã đăng") bài
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="m-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm flex items-center gap-2 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined">check_circle</span> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Listings Grid / List Table -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <th class="py-4 px-6 w-96">Bài đăng phòng trọ</th>
                    <th class="py-4 px-6 text-center">Giá tiền</th>
                    <th class="py-4 px-6 text-center">Diện tích</th>
                    <th class="py-4 px-6 text-center">Trạng thái</th>
                    <th class="py-4 px-6 text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
                @if (Model != null && Model.Any())
                {
                    foreach (var listing in Model)
                    {
                        <tr class="hover:bg-gray-50/50 transition-colors">
                            <!-- Image + Title + Location -->
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-4">
                                    @if (!string.IsNullOrEmpty(listing.ImageUrl))
                                    {
                                        <img src="@listing.ImageUrl" class="w-16 h-12 rounded-lg object-cover border border-gray-100 flex-shrink-0" alt="Room thumbnail">
                                    }
                                    else
                                    {
                                        <div class="w-16 h-12 rounded-lg bg-gray-100 flex items-center justify-center text-gray-300 flex-shrink-0">
                                            <span class="material-symbols-outlined">image</span>
                                        </div>
                                    }
                                    <div class="truncate max-w-[300px]">
                                        <h4 class="font-bold text-gray-800 hover:text-secondary transition-colors">
                                            <a href="@Url.Action("Detail", "Home", new { id = listing.Id })" target="_blank">@listing.Title</a>
                                        </h4>
                                        <p class="text-xs text-gray-500 mt-1 flex items-center gap-1 truncate">
                                            <span class="material-symbols-outlined text-[14px]">location_on</span> @listing.Location
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <!-- Price -->
                            <td class="py-4 px-6 text-center font-bold text-gray-800">
                                @listing.Price.ToString("N0") <span class="text-xs font-normal text-gray-500">đ/th</span>
                            </td>
                            <!-- Area -->
                            <td class="py-4 px-6 text-center font-semibold text-gray-700">@listing.Area m²</td>
                            <!-- Status Badge -->
                            <td class="py-4 px-6 text-center">
                                @if (listing.StatusBadge == "Đã đăng")
                                {
                                    <span class="inline-flex items-center gap-1.5 bg-[#a2eded]/40 text-[#136A64] text-xs font-bold px-2.5 py-1 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#136A64]"></span> Đang hiển thị
                                    </span>
                                }
                                else if (listing.StatusBadge == "Đã ẩn")
                                {
                                    <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-600 text-xs font-bold px-2.5 py-1 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span> Đã ẩn
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 bg-orange-50 text-orange-600 text-xs font-bold px-2.5 py-1 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span> Chờ duyệt
                                    </span>
                                }
                            </td>
                            <!-- Quick Action buttons -->
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (listing.StatusBadge != "Đã đăng")
                                    {
                                        <form asp-action="ApproveListing" asp-route-id="@listing.Id" method="post" class="inline m-0">
                                            <button type="submit" class="bg-green-50 text-green-700 hover:bg-green-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold border border-green-200 shadow-sm transition-colors flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[16px]">check</span> Duyệt
                                            </button>
                                        </form>
                                    }
                                    @if (listing.StatusBadge != "Đã ẩn")
                                    {
                                        <form asp-action="RejectListing" asp-route-id="@listing.Id" method="post" class="inline m-0">
                                            <button type="submit" class="bg-red-50 text-red-700 hover:bg-red-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold border border-red-200 shadow-sm transition-colors flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[16px]">block</span> Ẩn tin
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-8 text-center text-gray-400">
                            <span class="material-symbols-outlined text-[48px] mb-2">post_add</span>
                            <p class="font-medium">Chưa có bài đăng phòng trọ nào được tạo trong hệ thống.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
