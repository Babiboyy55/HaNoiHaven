@model IEnumerable<nhatro.Controllers.UserWithRolesViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tài khoản người dùng";
}

<div class="bg-white rounded-2xl border border-gray-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.05)] overflow-hidden">
    <!-- Header panel with success/error alerts -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 flex-wrap gap-4">
        <div>
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">manage_accounts</span> Danh sách thành viên hệ thống
            </h3>
            <p class="text-xs text-gray-500 mt-1">Xem, phân quyền vai trò (Chủ trọ, Khách hàng) và quản lý tài khoản người dùng</p>
        </div>
        <span class="bg-secondary/15 text-secondary text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Tổng: @Model.Count() người dùng
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="m-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm flex items-center gap-2 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined">check_circle</span> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="m-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-center gap-2 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined">warning</span> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Table Grid -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <th class="py-4 px-6">Họ và tên</th>
                    <th class="py-4 px-6">Địa chỉ Email</th>
                    <th class="py-4 px-6 text-center">Vai trò hiện tại</th>
                    <th class="py-4 px-6 text-center">Đổi vai trò</th>
                    <th class="py-4 px-6 text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <!-- FullName -->
                        <td class="py-4 px-6 font-bold text-gray-800">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                                    @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <p class="font-bold text-gray-800">@(string.IsNullOrEmpty(user.FullName) ? "Người dùng chưa đặt tên" : user.FullName)</p>
                                    @if (user.Email == User.Identity?.Name)
                                    {
                                        <span class="bg-blue-50 text-blue-600 text-[10px] font-bold px-1.5 py-0.5 rounded border border-blue-200 mt-1 inline-block">Tài khoản của bạn</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <!-- Email -->
                        <td class="py-4 px-6 text-gray-600 font-medium">@user.Email</td>
                        <!-- Role Badge -->
                        <td class="py-4 px-6 text-center">
                            @if (user.Role == "Admin")
                            {
                                <span class="inline-flex items-center gap-1 bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold px-2.5 py-1 rounded-full">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Admin
                                </span>
                            }
                            else if (user.Role == "Owner")
                            {
                                <span class="inline-flex items-center gap-1 bg-green-50 border border-green-200 text-green-700 text-xs font-bold px-2.5 py-1 rounded-full">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Chủ trọ
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-bold px-2.5 py-1 rounded-full">
                                    <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span> Khách thuê
                                </span>
                            }
                        </td>
                        <!-- Change Role Select -->
                        <td class="py-4 px-6 text-center">
                            <form asp-action="ChangeRole" method="post" class="inline-flex items-center gap-2 m-0">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <select name="newRole" onchange="this.form.submit()" class="bg-white border border-gray-200 rounded-lg py-1 px-3 text-xs font-medium text-gray-700 focus:border-secondary outline-none cursor-pointer">
                                    <option value="Renter" selected="@(user.Role == "Renter" ? "selected" : null)">Khách thuê</option>
                                    <option value="Owner" selected="@(user.Role == "Owner" ? "selected" : null)">Chủ trọ</option>
                                    <option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">Admin</option>
                                </select>
                            </form>
                        </td>
                        <!-- Actions -->
                        <td class="py-4 px-6 text-right">
                            @if (user.Email != User.Identity?.Name)
                            {
                                <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này? Thao tác này không thể hoàn tác!');" class="inline m-0">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <button type="submit" class="text-red-500 hover:text-red-700 hover:bg-red-50 p-2 rounded-lg transition-colors" title="Xóa tài khoản">
                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-gray-300 italic text-xs">Mặc định</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
